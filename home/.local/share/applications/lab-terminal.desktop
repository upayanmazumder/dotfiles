[Desktop Entry]
Type=Application
Name=Lab Terminal (sonder)
Comment=Plain bash shell, no fish/starship, no transparency/blur, Ubuntu Mono font, for school lab work
Exec=kitty -o shell=bash -o background_opacity=1.0 -o background_blur=0 -o font_family="Ubuntu Mono" -o bold_font=auto -o italic_font=auto -o bold_italic_font=auto -o font_size=12.0 --title "Lab Terminal" -e env "PS1=\\\\h> " bash --noprofile --norc
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
