[Unit]
Description=Keep EasyEffects' hardware output on the intended route (speaker/headphones)
After=pipewire-pulse.service bluetooth.target
Wants=pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/easyeffects-bt-relink.sh
Restart=always
RestartSec=2
# Easy Effects starts separately. Stop all routing helpers with this unit.
KillMode=control-group

[Install]
WantedBy=default.target
