[Unit]
Description=Watch reviewed system and desktop configuration

[Path]
PathChanged=/etc/dotfiles-autosync.json
PathChanged=/etc/default/grub
PathChanged=/etc/grub.d/09_custom
PathChanged=/etc/pacman.d/hooks/zz-cachyos-esp-boot.hook
PathChanged=/etc/pacman.d/hooks/zz-cachyos-grub-resync.hook
PathChanged=/usr/local/bin/cachyos-esp-boot-sync
PathChanged=/usr/local/bin/cachyos-grub-resync
PathChanged=/boot/efi/grub/grub.cfg
PathChanged=/boot/efi/grub/slot.cfg
PathChanged=/etc/mkinitcpio.conf
PathChanged=/etc/mkinitcpio-lean.conf
PathChanged=/etc/systemd/system/dotfiles-autosync.path
PathChanged=/etc/systemd/system/dotfiles-autosync.timer
PathChanged=/etc/systemd/system/dotfiles-autosync-collect.service
PathChanged=/etc/systemd/system/dotfiles-autosync-publish.service
PathChanged=/etc/sddm.conf.d/theme.conf
PathChanged=/etc/sysctl.d/99-lockup-detect.conf
PathChanged=/etc/systemd/journald.conf.d/50-crash-diagnosis.conf
PathChanged=/home/upayan/.agents/AGENTS.md
PathChanged=/home/upayan/.claude/CLAUDE.md
PathChanged=/home/upayan/.config/hypr/custom/liquidglass.lua
Unit=dotfiles-autosync-collect.service

[Install]
WantedBy=multi-user.target
