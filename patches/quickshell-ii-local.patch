+import QtQuick
+import qs.modules.common
+
+/**
+ * Apply shared touchpad sensitivity after content and nested controls have
+ * received input. Mouse-wheel notches and horizontal-only gestures use Qt.
+ * In ScrollView, declare this as an object property to keep it out of the
+ * control's default contentData. TextArea still supplies the content size.
+ */
+MouseArea {
+    id: root
+
+    required property Flickable flickable
+    property real touchpadScrollFactor: Config.options.interactions.scrolling.touchpadScrollFactor
+    property real touchpadSensitivity: Config.options.interactions.scrolling.touchpadSensitivity
+    readonly property bool scrolling: scrollTimer.running
+
+    // Normalize old absolute values against 450, preserving ratios rather
+    // than the old absolute movement speed.
+    readonly property real relativeFactor: touchpadScrollFactor > 10
+        ? touchpadScrollFactor / 450 : Math.max(0, touchpadScrollFactor)
+    property bool _pixelGesture: false
+    // Keep ownership until the phase reset, even when the inactivity timer expires.
+    property bool _enhancedGesture: false
+
+    // Stay in the viewport, behind content so nested views and wheel controls
+    // can handle input before it reaches this area's native Flickable parent.
+    parent: flickable.contentItem
+    x: flickable.contentX
+    y: flickable.contentY
+    width: flickable.width
+    height: flickable.height
+    z: -1
+    visible: Config.options.interactions.scrolling.fasterTouchpadScroll
+    enabled: flickable.interactive
+        && flickable.contentHeight + flickable.topMargin + flickable.bottomMargin > flickable.height
+        && flickable.flickableDirection !== Flickable.HorizontalFlick
+    acceptedButtons: Qt.NoButton
+
+    Timer {
+        id: scrollTimer
+        interval: 120
+        onTriggered: root._pixelGesture = false
+    }
+
+    // Native Qt tracking cannot resume halfway through our direct movement:
+    // it still has the old press origin. Chain enhanced movement explicitly.
+    function chainScroll(event) {
+        event.accepted = true
+        for (let ancestor = root.flickable.parent; ancestor; ancestor = ancestor.parent) {
+            if (!(ancestor instanceof Flickable)) continue
+            for (const child of ancestor.contentItem.children) {
+                if (child instanceof TouchpadScrollArea && child.enabled && child.visible) {
+                    child.handleWheel(event)
+                    event.accepted = true
+                    return
+                }
+            }
+        }
+    }
+
+    function handleWheel(event) {
+        event.accepted = false
+        const f = root.flickable
+        const dx = event.angleDelta.x
+        const dy = event.angleDelta.y
+        const px = event.pixelDelta.x
+        const py = event.pixelDelta.y
+        if (dx === 0 && dy === 0 && px === 0 && py === 0) {
+            root._pixelGesture = false
+            root._enhancedGesture = false
+            scrollTimer.stop()
+            // Qt needs gesture begin/end events to maintain its own tracking.
+            return
+        }
+        // A horizontal-only gesture starts with native Qt scrolling. Once
+        // enhanced tracking starts, keep both axes on the same path until end.
+        if (!root._enhancedGesture && dy === 0 && py === 0) return
+        // A mouse notch must pass through even just after a pixel gesture.
+        if (px === 0 && py === 0 && dy !== 0 && Math.abs(dy) % 120 === 0) return
+
+        root._enhancedGesture = true
+        if (px !== 0 || py !== 0) root._pixelGesture = true
+        scrollTimer.restart()
+        if (px === 0 && py === 0 && root._pixelGesture) {
+            // Ignore a rounded-to-zero pixel sample without changing units.
+            event.accepted = true
+            return
+        }
+        const scale = root.touchpadSensitivity * root.relativeFactor
+        const deltaY = -(root._pixelGesture ? py : dy / 12) * scale
+        const minY = f.originY - f.topMargin
+        const maxY = Math.max(minY, f.originY + f.contentHeight - f.height + f.bottomMargin)
+        const targetY = Math.max(minY, Math.min(maxY, f.contentY + deltaY))
+        const horizontal = f.flickableDirection !== Flickable.VerticalFlick
+            && f.contentWidth + f.leftMargin + f.rightMargin > f.width
+        const deltaX = horizontal ? -(root._pixelGesture ? px : dx / 12) * scale : 0
+        const minX = f.originX - f.leftMargin
+        const maxX = Math.max(minX, f.originX + f.contentWidth - f.width + f.rightMargin)
+        const targetX = horizontal ? Math.max(minX, Math.min(maxX, f.contentX + deltaX)) : f.contentX
+        if (targetY === f.contentY && targetX === f.contentX && (deltaY !== 0 || deltaX !== 0)) {
+            root.chainScroll(event)
+            return
+        }
+
+        f.cancelFlick()
+        if (horizontal) f.contentX = targetX
+        f.contentY = targetY
+        event.accepted = true
+    }
+
+    onWheel: event => root.handleWheel(event)
+}
diff --git a/modules/common/widgets/WidgetCard.qml b/modules/common/widgets/WidgetCard.qml
new file mode 100644
index 0000000..2f96154
--- /dev/null
+++ b/modules/common/widgets/WidgetCard.qml
@@ -0,0 +1,43 @@
+import QtQuick
+import qs.modules.common
+
+Rectangle {
+    id: root
+    required property var widget
+    property bool blurred: Config.options.background.widgets.blurWidgets
+    property bool shadowed: Config.options.background.widgets.shadow
+    property color tint: Appearance.colors.colLayer1
+    property real tintOpacity: 0.55
+    property bool glass: true
+
+    radius: Appearance.rounding?.verylarge ?? 30
+    color: glass && Config.options.background.widgets.glass.enable ? "transparent" : Appearance.colors.colPrimaryContainer
+
+    StyledRectangularShadow {
+        target: root
+        z: -2
+        visible: root.shadowed
+    }
+
+    FrostedGlass {
+        anchors.fill: parent
+        blurSource: root.widget.wallpaperItem
+        cardRadius: root.radius
+        tint: Appearance.colors.colPrimaryContainer
+        trackX: root.widget.x + root.x
+        trackY: root.widget.y + root.y
+        visible: root.glass && Config.options.background.widgets.glass.enable
+    }
+
+    FastBlurred {
+        anchors.fill: parent
+        anchors.margins: root.blurred ? -1 : 0
+        blurSource: root.widget.wallpaperItem
+        cardRadius: root.radius + (root.blurred ? 1 : 0)
+        tint: root.tint
+        tintOpacity: root.tintOpacity
+        trackX: root.widget.x + root.x
+        trackY: root.widget.y + root.y
+        visible: root.blurred && !(root.glass && Config.options.background.widgets.glass.enable)
+    }
+}
diff --git a/modules/common/widgets/WidgetFlipHandle.qml b/modules/common/widgets/WidgetFlipHandle.qml
new file mode 100644
index 0000000..3ffb8fa
--- /dev/null
+++ b/modules/common/widgets/WidgetFlipHandle.qml
@@ -0,0 +1,68 @@
+import QtQuick
+import qs.modules.common
+
+Item {
+    id: root
+
+    required property Item anchorItem
+    property bool hoverActive: false
+    property bool locked: false
+    property string icon: "rotate_right"
+    property real handleSize: 22
+    property int quarterTurns: 0
+    property string corner: "bottomRight"
+    readonly property bool engaged: area.containsMouse || area.pressed
+
+    signal clicked()
+
+    width: root.handleSize
+    height: root.handleSize
+    anchors {
+        horizontalCenter: root.anchorItem.right
+        verticalCenter: root.corner === "topRight" ? root.anchorItem.top : root.anchorItem.bottom
+        horizontalCenterOffset: -2
+        verticalCenterOffset: root.corner === "topRight" ? 2 : -2
+    }
+    opacity: (root.hoverActive || root.engaged) ? 1 : 0
+    visible: opacity > 0 && !root.locked
+    scale: root.engaged ? 1.18 : 1
+
+    Behavior on opacity {
+        NumberAnimation { duration: 150 }
+    }
+    Behavior on scale {
+        NumberAnimation { duration: 220; easing.type: Easing.OutBack; easing.overshoot: 2.4 }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        radius: width / 2
+        color: "#ffffff"
+        border.width: 2
+        border.color: "#101010"
+    }
+
+    MaterialSymbol {
+        anchors.centerIn: parent
+        text: root.icon
+        iconSize: 13
+        color: "#101010"
+        rotation: root.quarterTurns * 90
+
+        Behavior on rotation {
+            SpringAnimation { spring: 4.5; damping: 0.3; epsilon: 0.5 }
+        }
+    }
+
+    MouseArea {
+        id: area
+        anchors.fill: parent
+        anchors.margins: -6
+        hoverEnabled: true
+        cursorShape: Qt.PointingHandCursor
+        onClicked: {
+            root.quarterTurns += 1
+            root.clicked()
+        }
+    }
+}
diff --git a/modules/common/widgets/shaders/liquidLens.frag b/modules/common/widgets/shaders/liquidLens.frag
new file mode 100644
index 0000000..4a12c34
--- /dev/null
+++ b/modules/common/widgets/shaders/liquidLens.frag
@@ -0,0 +1,159 @@
+#version 440
+
+layout(location = 0) in vec2 qt_TexCoord0;
+layout(location = 0) out vec4 fragColor;
+
+layout(std140, binding = 0) uniform buf {
+    mat4 qt_Matrix;
+    vec4 radii;
+    vec4 wash;
+    float qt_Opacity;
+    vec2 size;
+    float rimWidth;
+    float pull;
+    float split;
+    float haze;
+    float vividness;
+    float sheen;
+    vec2 flares;
+    vec2 hangs;
+    float edge;
+};
+
+layout(binding = 1) uniform sampler2D backdrop;
+
+float roundedDist(vec2 p, vec2 half_, vec4 radii) {
+    float r = p.x > 0.0 ? (p.y > 0.0 ? radii.z : radii.y) : (p.y > 0.0 ? radii.w : radii.x);
+    r = min(r, min(half_.x, half_.y));
+    vec2 q = abs(p) - half_ + r;
+    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
+}
+
+float boxDist(vec2 p, vec2 half_) {
+    vec2 q = abs(p) - half_;
+    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0)));
+}
+
+float filletDist(vec2 p, float s, vec2 center, vec2 boxCenter, vec2 boxHalf) {
+    return max(boxDist(p - boxCenter, boxHalf), -(length(p - center) - s));
+}
+
+float shapeDist(vec2 p) {
+    vec2 q = p + size * 0.5;
+    float hang = max(hangs.x, hangs.y);
+    bool vert = edge > 1.5;
+    float along = vert ? size.y : size.x;
+    float depth = (vert ? size.x : size.y) - hang;
+
+    float u = vert ? q.y : q.x;
+    float v = edge < 0.5 ? q.y : edge < 1.5 ? size.y - q.y : edge < 2.5 ? q.x : size.x - q.x;
+
+    vec2 lo = edge < 0.5 ? vec2(flares.x, 0.0)
+        : edge < 1.5 ? vec2(flares.x, size.y - depth)
+        : edge < 2.5 ? vec2(0.0, flares.x)
+        : vec2(size.x - depth, flares.x);
+    vec2 hi = edge < 0.5 ? vec2(along - flares.y, depth)
+        : edge < 1.5 ? vec2(along - flares.y, size.y)
+        : edge < 2.5 ? vec2(depth, along - flares.y)
+        : vec2(size.x, along - flares.y);
+    float d = roundedDist(q - (lo + hi) * 0.5, (hi - lo) * 0.5, radii);
+
+    if (flares.x > 0.0) d = min(d, filletDist(vec2(u, v), flares.x, vec2(0.0, flares.x), vec2(flares.x, flares.x * 0.5), vec2(flares.x, flares.x * 0.5)));
+    if (flares.y > 0.0) d = min(d, filletDist(vec2(along - u, v), flares.y, vec2(0.0, flares.y), vec2(flares.y, flares.y * 0.5), vec2(flares.y, flares.y * 0.5)));
+    if (hangs.x > 0.0) d = min(d, filletDist(vec2(u, v - depth), hangs.x, vec2(hangs.x), vec2(hangs.x * 0.5, 0.0), vec2(hangs.x * 0.5, hangs.x)));
+    if (hangs.y > 0.0) d = min(d, filletDist(vec2(along - u, v - depth), hangs.y, vec2(hangs.y), vec2(hangs.y * 0.5, 0.0), vec2(hangs.y * 0.5, hangs.y)));
+    return d;
+}
+
+const float GLASS_IOR = 1.5;
+const vec2 LIGHT = vec2(-0.6, -0.8);
+
+vec3 backdropAt(vec2 px, float lod) {
+    vec2 uv = clamp((px + size * 0.5) / size, vec2(0.002), vec2(0.998));
+    return textureLod(backdrop, uv, lod).rgb;
+}
+
+vec3 diffuseAt(vec2 px, float lod, float reach) {
+    vec3 acc = backdropAt(px, lod) * 2.0;
+    for (int i = 0; i < 6; ++i) {
+        float a = 1.0471976 * float(i) + 0.3;
+        acc += backdropAt(px + vec2(cos(a), sin(a)) * reach, lod);
+    }
+    return acc / 8.0;
+}
+
+float domeHeight(float u) {
+    float v = 1.0 - u;
+    return sqrt(max(1.0 - v * v, 0.0));
+}
+
+float domeSlope(float u) {
+    float v = 1.0 - u;
+    return min(v / max(sqrt(max(1.0 - v * v, 0.0)), 0.12), 5.0);
+}
+
+vec2 bendRay(vec2 outward, float slope, float ior, float travel) {
+    vec3 normal = normalize(vec3(outward * slope, 1.0));
+    vec3 ray = refract(vec3(0.0, 0.0, -1.0), normal, 1.0 / ior);
+    return ray.xy / max(-ray.z, 0.25) * travel;
+}
+
+void main() {
+    vec2 p = qt_TexCoord0 * size - size * 0.5;
+    float d = shapeDist(p);
+    float cover = clamp(0.5 - d, 0.0, 1.0);
+    if (cover <= 0.0) {
+        fragColor = vec4(0.0);
+        return;
+    }
+
+    float depth = max(-d, 0.0);
+    vec2 e = vec2(0.8, 0.0);
+    vec2 outward = vec2(
+        shapeDist(p + e.xy) - shapeDist(p - e.xy),
+        shapeDist(p + e.yx) - shapeDist(p - e.yx));
+    outward = length(outward) > 1e-4 ? normalize(outward) : vec2(0.0, -1.0);
+
+    float bezel = max(rimWidth, 1.0);
+    float u = clamp(depth / bezel, 0.0, 1.0);
+    float slope = domeSlope(u);
+    float fall = (1.0 - u) * (1.0 - u);
+
+    float spreadK = split * (0.4 + 1.4 * fall);
+    vec2 shiftG = bendRay(outward, slope, GLASS_IOR, pull);
+    vec2 shiftR = bendRay(outward, slope, GLASS_IOR - spreadK, pull);
+    vec2 shiftB = bendRay(outward, slope, GLASS_IOR + spreadK, pull);
+
+    float lod = log2(max(haze, 1.0));
+    float reach = haze * 0.6;
+    vec3 col;
+    col.r = diffuseAt(p + shiftR, lod, reach).r;
+    col.g = diffuseAt(p + shiftG, lod, reach).g;
+    col.b = diffuseAt(p + shiftB, lod, reach).b;
+
+    float lum = dot(col, vec3(0.299, 0.587, 0.114));
+    col = mix(vec3(lum), col, vividness);
+
+    vec2 L = normalize(LIGHT);
+    float facing = dot(outward, L);
+    float lit = pow(max(facing, 0.0), 1.6);
+    float away = pow(max(-facing, 0.0), 2.2);
+
+    float hair = exp(-depth / 1.0);
+    float wide = exp(-depth / (bezel * 0.5));
+    float rimLight = (hair * (0.2 + 0.75 * lit + 0.25 * away) + wide * 0.14 * lit) * sheen;
+
+    float rimEnv = pow(1.0 - clamp(u, 0.0, 1.0), 2.0);
+    vec3 env = backdropAt(p + outward * bezel * 1.2, min(lod + 2.0, 6.0));
+    col = mix(col, env * 1.1 + 0.03, clamp(rimEnv * 0.35 * (0.4 + 0.6 * lit), 0.0, 0.5));
+
+    col *= 1.0 - 0.14 * wide * away;
+
+    float top = 1.0 - smoothstep(0.0, size.y * 0.55, p.y + size.y * 0.5);
+    col += vec3(0.03 * top * sheen);
+
+    col = mix(col, wash.rgb, wash.a);
+    col += vec3(rimLight);
+
+    fragColor = vec4(clamp(col, 0.0, 1.0) * cover, cover) * qt_Opacity;
+}
