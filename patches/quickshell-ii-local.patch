+
+        delegate: FadeLoader {
+            id: loaderDelegate
+            required property var modelData
+
+            property bool enableLoading: true
+
+            shown: {
+                const entry = Config.options.background.widgets[loaderDelegate.modelData.key];
+                if (!entry || !entry.enable)
+                    return false;
+                return loaderDelegate.enableLoading;
