#!/usr/bin/env bash
# Stub grub-mkconfig: reads GRUB_CMDLINE_LINUX_DEFAULT from /etc/default/grub
# and bakes it into a fake grub.cfg, like the real 10_linux script would.
set -euo pipefail
log() { echo "[stub:grub-mkconfig] $*" >> "${STUB_LOG:-/dev/null}"; }

out=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o) out="$2"; shift 2 ;;
        *) shift ;;
    esac
done
[[ -n "$out" ]] || { echo "grub-mkconfig stub: missing -o" >&2; exit 1; }

cmdline="$(grep -E '^GRUB_CMDLINE_LINUX_DEFAULT=' /etc/default/grub 2>/dev/null | sed -E 's/^GRUB_CMDLINE_LINUX_DEFAULT="?(.*)"?$/\1/; s/"$//')"

mkdir -p "$(dirname -- "$out")"
{
    echo "# stub grub.cfg — generated by tests/stubs/grub-mkconfig"
    echo "menuentry 'Arch Linux' {"
    echo "    linux /vmlinuz-linux root=UUID=stub rw ${cmdline}"
    echo "    initrd /initramfs-linux.img"
    echo "}"
} > "$out"
log "wrote $out with cmdline: $cmdline"
